      },
      "runner_contract": "midataworks.runner/v1",
      "source": "def check(text, params):\n    import re\n    n = 0\n    for m in re.findall(r\"[0-9][0-9 -]{10,30}[0-9]\", text):\n        digits = [int(c) for c in m if c.isdigit()]\n        if len(digits) < 12:\n            continue\n        total, parity = 0, len(digits) % 2\n        for i, d in enumerate(digits):\n            if i % 2 == parity:\n                d *= 2\n                if d > 9:\n                    d -= 9\n            total += d\n        if total % 10 == 0:\n            n += 1\n    return n\n"
    },
