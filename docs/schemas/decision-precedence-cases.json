      "note": "no window named: the probe's own scope; its length bands refine the global bar",
      "probe": {
        "threshold": 0.5,
        "length_bands": [
          {
            "min_tokens": 0,
            "max_tokens": 100,
            "threshold": 0.4,
            "threshold_source": "band"
          },
          {
            "min_tokens": 101,
            "max_tokens": null,
            "threshold": 0.6,
            "threshold_source": "band"
          }
        ],
        "scope": "all"
      },
      "window_entry": null,
      "window": null,
      "n_scored": 10,
      "expect": {
        "threshold": 0.4,
        "rule": "probe_band"
      }
