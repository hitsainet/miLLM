{
  "$defs": {
    "AttachedRuleSet": {
      "additionalProperties": true,
      "properties": {
        "rule_set_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rule Set Digest",
          "type": "string"
        },
        "rule_set_id": {
          "pattern": "^[A-Za-z0-9._:-]{1,64}$",
          "title": "Rule Set Id",
          "type": "string"
        }
      },
      "required": [
        "rule_set_id",
        "rule_set_digest"
      ],
      "title": "AttachedRuleSet",
      "type": "object"
    },
    "BehaviourOut": {
      "additionalProperties": true,
      "description": "The behaviour the probe's DEFINITION names (never a code constant, FR-38.1).",
      "properties": {
        "key": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$",
          "title": "Key",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "key"
      ],
      "title": "BehaviourOut",
      "type": "object"
    },
    "DecisionOut": {
      "additionalProperties": true,
      "properties": {
        "calibration_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9._:-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Id"
        },
        "provisional": {
          "title": "Provisional",
          "type": "boolean"
        },
        "target_fpr": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Fpr"
        }
      },
      "required": [
        "provisional"
      ],
      "title": "DecisionOut",
      "type": "object"
    },
    "ProbeResult": {
      "additionalProperties": true,
      "description": "`kind: \"probe\"` — what one armed probe concluded over one window of one request.",
      "properties": {
        "basis": {
          "anyOf": [
            {
              "default": "unknown",
              "enum": [
                "residual",
                "sae_features",
                "unknown"
              ],
              "title": "Basis",
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9_.\\-]{0,63}$",
              "type": "string"
            }
          ],
          "default": "unknown"
        },
        "batch_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9._:-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Id"
        },
        "batch_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Line"
        },
        "behaviour": {
          "anyOf": [
            {
              "$ref": "#/$defs/BehaviourOut"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "calibration_ref": {
          "default": null,
          "title": "Calibration Ref",
          "type": "null"
        },
        "choice_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Choice Index"
        },
        "comparator": {
          "const": ">=",
          "default": ">=",
          "title": "Comparator",
          "type": "string"
        },
        "completed_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
          "title": "Completed At",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/DecisionOut"
        },
        "decision_digest": {
          "default": "unknown",
          "pattern": "^([0-9a-f]{64}|unknown)$",
          "title": "Decision Digest",
          "type": "string"
        },
        "decision_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "miStudio's revision of the decision (the producer's); null when the producer stated none.",
          "title": "Decision Revision"
        },
        "definition_schema": {
          "anyOf": [
            {
              "const": "mistudio.probe-definition/v1",
              "default": "mistudio.probe-definition/v1",
              "title": "Definition Schema",
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9_.\\-]{0,63}$",
              "type": "string"
            }
          ],
          "default": "mistudio.probe-definition/v1"
        },
        "definition_scope": {
          "anyOf": [
            {
              "default": "unknown",
              "enum": [
                "all",
                "prompt",
                "response",
                "last_user",
                "unknown"
              ],
              "title": "Definition Scope",
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9_.\\-]{0,63}$",
              "type": "string"
            }
          ],
          "default": "unknown"
        },
        "detector_digest": {
          "default": "unknown",
          "pattern": "^([0-9a-f]{64}|unknown)$",
          "title": "Detector Digest",
          "type": "string"
        },
        "detector_digest_source": {
          "anyOf": [
            {
              "default": "unknown",
              "enum": [
                "producer",
                "computed",
                "unknown"
              ],
              "title": "Detector Digest Source",
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9_.\\-]{0,63}$",
              "type": "string"
            }
          ],
          "default": "unknown"
        },
        "engine": {
          "anyOf": [
            {
              "default": "transformers",
              "enum": [
                "transformers",
                "llamacpp",
                "cbm"
              ],
              "title": "Engine",
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9_.\\-]{0,63}$",
              "type": "string"
            }
          ],
          "default": "transformers"
        },
        "evaluation_ms": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluation Ms"
        },
        "event_time": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
          "title": "Event Time",
          "type": "string"
        },
        "event_time_source": {
          "anyOf": [
            {
              "default": "finalized",
              "enum": [
                "finalized",
                "inserted"
              ],
              "title": "Event Time Source",
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9_.\\-]{0,63}$",
              "type": "string"
            }
          ],
          "default": "finalized"
        },
        "execution_mode": {
          "anyOf": [
            {
              "default": "serial",
              "enum": [
                "serial",
                "batched",
                "continuous_batching",
                "speculative"
              ],
              "title": "Execution Mode",
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9_.\\-]{0,63}$",
              "type": "string"
            }
          ],
          "default": "serial"
        },
        "fires": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fires"
        },
        "hook": {
          "anyOf": [
            {
              "default": "unknown",
              "enum": [
                "resid_post",
                "unknown"
              ],
              "title": "Hook",
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9_.\\-]{0,63}$",
              "type": "string"
            }
          ],
          "default": "unknown"
        },
        "identity_algorithm": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "const": "mistudio.probe-identity/1",
                  "type": "string"
                },
                {
                  "pattern": "^[a-z][a-z0-9_.\\-]{0,63}$",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity Algorithm"
        },
        "input_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Index"
        },
        "kind": {
          "const": "probe",
          "default": "probe",
          "title": "Kind",
          "type": "string"
        },
        "layer": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layer"
        },
        "migrated": {
          "default": false,
          "title": "Migrated",
          "type": "boolean"
        },
        "model_load_id": {
          "default": "unknown",
          "pattern": "^([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|unknown)$",
          "title": "Model Load Id",
          "type": "string"
        },
        "model_revision": {
          "default": "unknown",
          "pattern": "^([0-9a-f]{40}|[A-Za-z0-9._/\\-]{1,100})$",
          "title": "Model Revision",
          "type": "string"
        },
        "n_scored_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "N Scored Tokens",
          "type": "integer"
        },
        "origin": {
          "anyOf": [
            {
              "enum": [
                "live",
                "batch",
                "stateless"
              ],
              "title": "Origin",
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9_.\\-]{0,63}$",
              "type": "string"
            }
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "completed",
                "skipped",
                "failed",
                "interrupted"
              ],
              "title": "Outcome",
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9_.\\-]{0,63}$",
              "type": "string"
            }
          ]
        },
        "parity_status": {
          "anyOf": [
            {
              "default": "unknown",
              "enum": [
                "passed",
                "failed",
                "never_run",
                "unknown"
              ],
              "title": "Parity Status",
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9_.\\-]{0,63}$",
              "type": "string"
            }
          ],
          "default": "unknown"
        },
        "persistence": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "enum": [
                    "persisted",
                    "not_persisted",
                    "unknown"
                  ],
                  "type": "string"
                },
                {
                  "pattern": "^[a-z][a-z0-9_.\\-]{0,63}$",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recorded copies only.",
          "title": "Persistence"
        },
        "precision": {
          "default": "unknown",
          "pattern": "^[a-z0-9_]{1,32}$",
          "title": "Precision",
          "type": "string"
        },
        "probability": {
          "default": null,
          "title": "Probability",
          "type": "null"
        },
        "probe_id": {
          "pattern": "^[A-Za-z0-9._:-]{1,64}$",
          "title": "Probe Id",
          "type": "string"
        },
        "probe_name": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9._:+\\-() ]{1,200}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probe Name"
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "A code from the published list (millm/services/probe_reasons.py); null when outcome is completed. Consumers read an unknown code as other. Known codes: batched_request, cancelled, client_disconnected, continuous_batching, encoder_failed, engine_unsupported, generation_error, generation_thread_hung, head_mismatch, judge_traffic, last_user_span_unknown, last_user_span_unresolved, no_chat_template, no_scored_tokens, no_user_header, no_user_turn, non_finite_score, prompt_boundary_conflict, prompt_boundary_invalid, prompt_boundary_unknown, rule_error, rule_input_too_large, rule_load_refused, rule_output_invalid, rule_resource_limit, rule_set_vectors_failed, rule_signals_disabled, rule_timeout, rule_worker_unavailable, speculative_decoding, text_completion_has_no_user_turn."
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9._:-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "result_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Result Id",
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "default": "unknown",
              "enum": [
                "mean",
                "max",
                "last",
                "softmax",
                "attention",
                "rolling_mean_max",
                "unknown"
              ],
              "title": "Rule",
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9_.\\-]{0,63}$",
              "type": "string"
            }
          ],
          "default": "unknown"
        },
        "rung": {
          "maximum": 3,
          "minimum": 0,
          "title": "Rung",
          "type": "integer"
        },
        "rung_language": {
          "pattern": "^[a-z0-9 ,()'.\\-]{1,80}$",
          "title": "Rung Language",
          "type": "string"
        },
        "schema": {
          "const": "mi.probe.result/v1",
          "default": "mi.probe.result/v1",
          "title": "Schema",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "score_semantics": {
          "anyOf": [
            {
              "const": "raw_margin",
              "default": "raw_margin",
              "title": "Score Semantics",
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9_.\\-]{0,63}$",
              "type": "string"
            }
          ],
          "default": "raw_margin"
        },
        "scored": {
          "title": "Scored",
          "type": "boolean"
        },
        "served_model": {
          "default": "unknown",
          "pattern": "^([A-Za-z0-9._:/+@\\- ]{1,255})$",
          "title": "Served Model",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9._:-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "set": {
          "anyOf": [
            {
              "$ref": "#/$defs/SetBlock"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_event_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recorded copies only: the probe_events.id this result is stored as.",
          "title": "Source Event Id"
        },
        "span_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "status": {
          "anyOf": [
            {
              "default": "final",
              "enum": [
                "final",
                "partial",
                "unavailable"
              ],
              "title": "Status",
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9_.\\-]{0,63}$",
              "type": "string"
            }
          ],
          "default": "final"
        },
        "steering_ref": {
          "$ref": "#/$defs/SteeringRef"
        },
        "target": {
          "anyOf": [
            {
              "default": "unknown",
              "enum": [
                "positive_class",
                "unknown"
              ],
              "title": "Target",
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9_.\\-]{0,63}$",
              "type": "string"
            }
          ],
          "default": "unknown"
        },
        "template_sha256": {
          "default": "unknown",
          "pattern": "^([0-9a-f]{64}|unknown)$",
          "title": "Template Sha256",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "threshold_revision": {
          "default": 1,
          "description": "miLLM's own counter of the bar that judged this result.",
          "minimum": 1,
          "title": "Threshold Revision",
          "type": "integer"
        },
        "trace_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "turn_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn Index"
        },
        "verdict": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verdict"
        },
        "window": {
          "anyOf": [
            {
              "enum": [
                "all",
                "prompt",
                "response",
                "last_user"
              ],
              "title": "Window",
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9_.\\-]{0,63}$",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "basis",
        "batch_id",
        "batch_line",
        "behaviour",
        "calibration_ref",
        "choice_index",
        "comparator",
        "completed_at",
        "decision",
        "decision_digest",
        "decision_revision",
        "definition_schema",
        "definition_scope",
        "detector_digest",
        "detector_digest_source",
        "engine",
        "evaluation_ms",
        "event_time",
        "event_time_source",
        "execution_mode",
        "fires",
        "hook",
        "identity_algorithm",
        "input_index",
        "kind",
        "layer",
        "migrated",
        "model_load_id",
        "model_revision",
        "n_scored_tokens",
        "origin",
        "outcome",
        "parity_status",
        "precision",
        "probability",
        "probe_id",
        "probe_name",
        "producer",
        "reason",
        "request_id",
        "result_id",
        "rule",
        "rung",
        "rung_language",
        "schema",
        "score",
        "score_semantics",
        "scored",
        "served_model",
        "session_id",
        "set",
        "span_id",
        "status",
        "steering_ref",
        "target",
        "template_sha256",
        "threshold",
        "threshold_revision",
        "trace_id",
        "turn_index",
        "verdict",
        "window"
      ],
      "title": "ProbeResult",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "anyOf": [
            {
              "const": "millm",
              "default": "millm",
              "title": "Name",
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9_.\\-]{0,63}$",
              "type": "string"
            }
          ],
          "default": "millm"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.\\-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "title": "Producer",
      "type": "object"
    },
    "RuleResult": {
      "additionalProperties": true,
      "description": "`kind: \"rule\"` — Part A's rule signal (D38.2). Defined in v1 so miLLM 039 emits it without\na schema change; 038 never produces one.",
      "properties": {
        "batch_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9._:-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Id"
        },
        "batch_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Line"
        },
        "behaviour": {
          "anyOf": [
            {
              "$ref": "#/$defs/BehaviourOut"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "count": {
          "default": 0,
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "event_time": {
