    },
    "masked": {
      "signal": "masked"
    },
    "named": {
      "signal": "named"
    },
    "valid": {
      "signal": "valid"
    }
  },
  "format": "midataworks.rule-set/v1",
  "name": "card-pan-elements",
  "outputs": [
