        "known_divergence": {
          "mistudio": "miStudio tokenizes every render with add_special_tokens=False, so on this form it trains on ZERO BOS while miLLM serves one (TinyLlama-Chat / Zephyr-style templates). `expected` is the rule, which miLLM meets. miStudio runs this case as a STRICT xfail - red the moment either side changes - until the operator decides between adopting the one-BOS rule (recording add_special_tokens per model) and refusing such models. Tracked: miStudio 0xcc/reviews/served_render_cases_2026-10-08.md."
        },
        "expected": {
          "generation_prompt": true,
          "prompt_tokens": 7,
          "tokens": [
            "<s>",
            "<|user|>",
            "virus",
            "spreads",
            "fast",
            "<|end|>",
            "<|assistant|>"
          ],
          "last_user_span": [
            1,
            6
          ]
        }
      },
      {
        "name": "template writes no BOS and the tokenizer adds none: zero, nothing invented",
        "template": "no_bos",
        "tokenizer_adds_bos": false,
        "bos_token": null,
        "messages": [
          {
            "role": "user",
            "content": "virus spreads fast"
          }
        ],
        "expected": {
          "generation_prompt": true,
          "prompt_tokens": 6,
          "tokens": [
            "<|user|>",
            "virus",
            "spreads",
            "fast",
            "<|end|>",
            "<|assistant|>"
          ],
          "last_user_span": [
            0,
            5
          ]
        }
      }
    ]
