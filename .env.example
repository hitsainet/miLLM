# =============================================================================
# miLLM Configuration
# =============================================================================
# Copy this file to .env and modify as needed.
# All values shown are defaults.

# =============================================================================
# Database
# =============================================================================
# PostgreSQL connection string (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/millm

# =============================================================================
# Storage
# =============================================================================
# Directory for cached HuggingFace models
# Ensure this directory exists and has write permissions
MODEL_CACHE_DIR=/data/models

# Directory for cached SAE files
SAE_CACHE_DIR=/data/sae

# =============================================================================
# HuggingFace
# =============================================================================
# Access token for gated models (optional)
# Get yours at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# A token saved on the Admin UI's Settings page outranks HF_TOKEN; a per-request token outranks
# both. Saving one needs SETTINGS_ENCRYPTION_KEY (the token is stored encrypted; with no key the
# save is refused). Generate once with `openssl rand -base64 32` and keep it: a saved token
# cannot be read under a different key.
# SETTINGS_ENCRYPTION_KEY=

# =============================================================================
# Server
# =============================================================================
# Host to bind to
HOST=0.0.0.0

# Port to listen on
PORT=8000

# Enable debug mode (more verbose logging, auto-reload)
DEBUG=false

# =============================================================================
# CORS
# =============================================================================
# Allowed origins (comma-separated, or * for all)
CORS_ORIGINS=*

# =============================================================================
# Logging
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json (production) or console (development)
LOG_FORMAT=console

# =============================================================================
# Timeouts
# =============================================================================
# Seconds to wait for graceful model unload
GRACEFUL_UNLOAD_TIMEOUT=30.0

# LOG_LEVEL, GRACEFUL_UNLOAD_TIMEOUT and 28 other settings can also be changed while
# miLLM runs, on the Admin UI's Settings page (Environment). A value saved there
# outranks this file until "Use the environment value" clears it.

# =============================================================================
# Probe monitors (Feature 24) — optional
# =============================================================================
# Every PROBE_* setting has a working default in millm/core/config.py, and feature
# settings are otherwise not listed here (sensing and circuit sensing are not).
# This one is, because it changes how requests are SERVED rather than how probes
# behave: while any probe is armed, continuous batching is disabled and requests
# run serially. On a busy deployment that is a throughput decision, not a detail.
#
# Turning it off does not make probes score under continuous batching — that path
# marks the request not_scored with a reason instead, because a probe must never
# go silently quiet.
#PROBE_FORCE_SERIAL=true

# Many probes, measured (Feature 37; ENH-006 D83). Arming measures each probe's cost per
# forward pass on its layer's card and refuses one that would take the armed set over the
# budget times PROBE_BUDGET_HEADROOM: probes may slow each token by at most
# PROBE_SLOWDOWN_BUDGET_PCT of the model's own measured time. There is no limit in behaviours.
# PROBE_MAX_ARMED stays as a probe backstop.
#PROBE_MAX_ARMED=64
#PROBE_SLOWDOWN_BUDGET_PCT=5.0
#
# Behaviour sets (Feature 39).
#PROBE_VERDICT_HEADER_MAX_BYTES=8192
#PROBE_MAX_IMPORTED=10000
#PROBE_MAX_PER_BEHAVIOUR=32
#PROBE_LIST_PAGE_SIZE=200
#
# Rule signals (Feature 39 S2). Rule sets are miDataworks rule-set documents imported
# through /api/rule-sets; attached to a behaviour, their signals run beside its armed
# probes within RULE_TIME_BUDGET_MS. Operator code (code_rule) never runs inline.
#RULE_SIGNALS_ENABLED=true
#RULE_TIME_BUDGET_MS=20
#RULE_SETS_MAX_IMPORTED=1000
#RULE_SET_MAX_SIGNALS=64
#RULE_SET_MAX_BYTES=1048576
# 039 S3: operator code (code_rule) runs in the rule-runner sidecar AFTER the response, never on
# the live path. Per-call bounds (never below the runner contract floor: 64 MiB, 4096 bytes),
# calls per request, the bytes of code documents one import may carry, and the shared socket.
#RULE_CODE_CALL_WALL_MS=2000
#RULE_CODE_CALL_MEMORY_MIB=64
#RULE_CODE_CALL_OUTPUT_BYTES=4096
#RULE_CODE_CALLS_PER_REQUEST=16
#RULE_CODE_MODULES_MAX_BYTES=4194304
#RULE_RUNNER_SOCKET=/run/millm-rules/runner.sock
# The reference set each model's recommendation counts in ("how many of these fit").
#PROBE_REFERENCE_SET_SHAPE={"probes": 9, "layers": 3, "rules": {"mean": 3, "max": 3, "attention": 3}}
# The FALLBACK budgets, for a model whose step time is not measured yet.
#PROBE_MAX_OVERHEAD_MS_PER_PASS=0.25
#PROBE_MAX_PREFILL_MS_PER_1K=0.5
#PROBE_BUDGET_HEADROOM=0.9
#PROBE_COST_SAMPLES=20
#PROBE_CAPACITY_DECODE_STEPS=32

# Probe sessions (Feature 36). Listed because PROBE_TRANSCRIPTS decides whether
# user text is stored at all: `on` records the newest user message and the reply
# of every monitored chat turn for PROBE_TRANSCRIPT_MAX_AGE_DAYS. Off by default.
#PROBE_TRANSCRIPTS=off
#PROBE_TRANSCRIPT_MAX_AGE_DAYS=7
#PROBE_TRANSCRIPT_MAX_TURNS=20000
#PROBE_SESSION_IDLE_MINUTES=30
#PROBE_SESSION_MAX_AGE_DAYS=30
#PROBE_RETENTION_INTERVAL_S=300

# =============================================================================
# Stateless probe scoring and per-request activations (Feature 27) — optional
# =============================================================================
# Inputs and probes per POST /api/probes/score call. Each input takes its own
# queue slot, so these bound how long one call runs, not how long others wait.
#PROBE_SCORE_MAX_INPUTS=64
# return_sae_activations: largest top_k, the worst-case positions x top_k a
# request may return (checked BEFORE generation), and positions encoded per chunk.
#SAE_ACTIVATIONS_MAX_TOP_K=64
#SAE_ACTIVATIONS_MAX_ENTRIES=65536
#SAE_ACTIVATIONS_ENCODE_CHUNK=512

# =============================================================================
# Request validation and structured output (Feature 25) — optional
# =============================================================================
# Compiled JSON-Schema grammars kept per loaded model (least recently used out).
#STRUCTURED_OUTPUT_GRAMMAR_CACHE=64
# Byte bound on the X-miLLM-Ignored-Fields response header; past it the header
# ends with "+N more" instead of growing.
#IGNORED_FIELDS_HEADER_MAX_BYTES=1024

# =============================================================================
# Batch API (Feature 26) — optional
# =============================================================================
# Float32 scoring (FR-25.15): where a scoring_precision="float32" request builds its float32 copy
# of the model (4 bytes/parameter, released after the request). auto = the model's card if it fits,
# else the CPU if it fits, else 409 reason=memory. cpu | cuda | cuda:N pin it (never swapped).
#SCORING_FLOAT32_DEVICE=auto
# MB that must stay free beyond the copy (forward activations, allocator slack).
#SCORING_FLOAT32_HEADROOM_MB=1024

# Where uploaded and assembled batch file BYTES live (metadata is in PostgreSQL).
#BATCH_FILES_DIR=/app/batch_files
# Upload limits (OpenAI's): a file over either is refused at upload, never truncated.
#BATCH_MAX_ROWS=50000
#BATCH_MAX_FILE_BYTES=209715200
# A longer input line is an invalid line (line_too_large).
#BATCH_MAX_LINE_BYTES=1048576
# T-63 / 026 9.4: packing is OFF by default — measured on JEV-9B (bf16), 0.57% of packed rows
# changed their top token. A batch may send pack=true for ~2.7x speed. An unparseable value
# falls back to the default (false).
#BATCH_PACK_DEFAULT=false
# Single-row forwards per chunk (one admission slot per chunk), and the pack bounds.
#BATCH_CHUNK_ROWS=8
#BATCH_PACK_MAX_ROWS=16
#BATCH_PACK_MAX_TOKENS=16384
# completion_window accepts whole hours 1..this ("24h" is OpenAI's value).
#BATCH_MAX_COMPLETION_WINDOW_HOURS=168
# Input files expire this many days after upload (outputs follow output_expires_after).
#BATCH_FILE_RETENTION_DAYS=30
# The batch's own lease TTL (renewed at a third), and the waiting batch's retry interval.
#BATCH_LEASE_TTL_S=900
#BATCH_WAIT_POLL_S=10
# batch:progress at most this often per batch (transitions always emit).
#BATCH_PROGRESS_MIN_INTERVAL_S=1
# Validation errors listed on the batch object (the error file has every one).
#BATCH_ERRORS_SHOWN=100
# How often expired batch files are pruned (also once at startup).
#BATCH_RETENTION_INTERVAL_S=3600
# Batch generation rows' probe and sensing events, capped apart from live traffic.
#PROBE_MAX_BATCH_EVENTS_PER_PROBE=50000
#SENSING_MAX_BATCH_EVENTS_PER_CLUSTER=50000
#CIRCUIT_SENSING_MAX_BATCH_EVENTS_PER_CIRCUIT=50000

# =============================================================================
# Model lease, backpressure and GPU visibility (Feature 29) — optional
# =============================================================================
# A lease pins the resident model for its holder (POST /api/models/{id}/lease).
# Leases live in process memory: a restart ends every lease. TTL default = maximum.
#LEASE_DEFAULT_TTL_SECONDS=7200
#LEASE_MAX_TTL_SECONDS=7200
# Bounds on the free-text holder label and reason (characters, after stripping).
#LEASE_HOLDER_MAX_CHARS=128
#LEASE_REASON_MAX_CHARS=512
# Ended leases remembered so renew/release of a seen ID answers 409 LEASE_EXPIRED.
#LEASE_ENDED_MEMORY=64
# Slot-holding durations kept for the estimated wait on /api/health/detailed.
#QUEUE_DURATION_WINDOW=50
# Retry-After seconds on 503s. QUEUE_FULL uses the estimated wait clamped to
# RETRY_AFTER_MAX_S, or RETRY_AFTER_QUEUE_DEFAULT_S without an estimate.
#RETRY_AFTER_QUEUE_DEFAULT_S=5
#RETRY_AFTER_MAX_S=60
# MODEL_BUSY / MODEL_LOADING: a load in progress, and an unload in progress.
#RETRY_AFTER_LOAD_S=15
#RETRY_AFTER_UNLOAD_S=5
#RETRY_AFTER_NOT_LOADED_S=30
#RETRY_AFTER_MEMORY_S=30
# The readiness probe's 503.
#RETRY_AFTER_READINESS_S=5
# Any other 503 that reached the response without a Retry-After (logged as a warning).
#RETRY_AFTER_FALLBACK_S=10
# WEIGHTS_TORN (Feature 31): recovery is a late commit-end or a weights load.
#RETRY_AFTER_WEIGHTS_TORN_S=30

# =============================================================================
# Attachable weights (Features 31, 32, 33) — optional
# =============================================================================
# Bearer tokens for the gated /api/weights routes (attach, quiesce, commit, save,
# load, adapter load/unload). A JSON array of digests, never plaintext:
#   [{"label": "miforge", "role": "trainer", "sha256": "<64 hex>"}]
# Compute a digest with:  printf %s "$TOKEN" | sha256sum
# Roles: trainer or operator; labels unique. Empty or malformed refuses every gated
# call with 401 WEIGHTS_UNAUTHORIZED (the server still starts). Serving an adapter
# with no trainer needs an operator token. In Kubernetes it comes from a Secret.
#WEIGHTS_TOKENS=[]
# A quiesce left open longer than this resumes serving on its own.
#WEIGHTS_HOLD_TIMEOUT_S=5.0
# A commit open longer than this marks the weights torn. 10x the measured p99.9, rounded
# up to the next 100 ms: miForge's real trainer (f11w2-r2, 1,000 steps, 8-bit AdamW, RTX 3090, 2026-10-17)
# measured commit p99.9 71.0 ms (D45).
#WEIGHTS_COMMIT_WATCHDOG_MS=800
# An attachment without a heartbeat for this long is stale; the hint must be below it.
#WEIGHTS_HEARTBEAT_TIMEOUT_S=30.0
#WEIGHTS_HEARTBEAT_INTERVAL_HINT_S=5.0
# How long a quiesce or serving pause waits for in-flight work to drain.
#WEIGHTS_QUIESCE_DRAIN_TIMEOUT_S=60.0
# Checkpoint root miLLM writes (k8s: /data/checkpoints); adapters live under it too.
#WEIGHTS_CHECKPOINT_DIR=/app/checkpoints
# Further checkpoint roots, read only, comma-separated absolute paths (e.g. miForge's volume).
#WEIGHTS_CHECKPOINT_READ_ROOTS=
# Lineage walk bound, disk headroom factor for a save, and the config/tokenizer allowance (MB).
#WEIGHTS_LINEAGE_MAX_DEPTH=10000
#WEIGHTS_SAVE_FREE_SPACE_FACTOR=1.1
#WEIGHTS_SAVE_OVERHEAD_MB=64

# =============================================================================
# Embedding options (Feature 30) — optional
# =============================================================================
# Maximum strings in one /v1/embeddings request (1-2048). A request over it is
# refused with 400 before any model load. A capped request holds the only
# admission slot, so this bounds how long a chat waits behind it. 256 is
# provisional until measured on the RTX 3090 (cap x p95 per input <= 30 s).
#EMBEDDINGS_MAX_INPUTS=256

# =============================================================================
# Circuits (Feature 19) — optional
# =============================================================================
# Several circuits may serve at once on disjoint layers, and an operator may
# compose two on a shared layer with allow_layer_overlap. On by default since
# 2026-10-16 (decision D19); false makes contention unoverridable and keeps only
# the most recently activated circuit across a restart.
#CIRCUIT_ALLOW_CONCURRENT=true

# =============================================================================
# OpenTelemetry export (Feature 38) — OFF by default
# =============================================================================
# Nothing leaves the deployment unless you switch a signal on AND name a receiver.
# Exported data never carries prompt or reply text, decoded context, token ids,
# activations, weights, acknowledgement text, exception messages or secrets: every
# attribute passes an allowlist before it is queued. Only these three switches
# enable anything; none of these settings can be changed from the Settings page.
#TELEMETRY_TRACES_ENABLED=false
#TELEMETRY_METRICS_ENABLED=false
#TELEMETRY_LOGS_ENABLED=false
# OTLP/HTTP receiver base URL (/v1/traces, /v1/metrics, /v1/logs are appended).
# https:// with certificate validation; http:// is refused unless ALLOW_PLAINTEXT.
#TELEMETRY_ENDPOINT=https://otel-collector.example:4318
#TELEMETRY_PROTOCOL=http/protobuf
# Receiver credentials, k=v,k=v (secret; shown only as set/not set).
#TELEMETRY_HEADERS=
#TELEMETRY_TLS_CA_FILE=
#TELEMETRY_TLS_CLIENT_CERT_FILE=
#TELEMETRY_TLS_CLIENT_KEY_FILE=
#TELEMETRY_ALLOW_PLAINTEXT=false
#TELEMETRY_SERVICE_NAME=millm
#TELEMETRY_SERVICE_INSTANCE_ID=
#TELEMETRY_DEPLOYMENT_ENVIRONMENT=
# Per-signal bounded queue and export batch; timeouts in seconds.
#TELEMETRY_QUEUE_SIZE=8192
#TELEMETRY_BATCH_SIZE=512
#TELEMETRY_EXPORT_TIMEOUT_S=10
#TELEMETRY_RETRY_HORIZON_S=60
#TELEMETRY_DRAIN_DEADLINE_S=5
#TELEMETRY_METRIC_INTERVAL_S=15
#TELEMETRY_TRACES_SAMPLER_RATIO=1.0
# Series per metric instrument before folding into the overflow series.
#TELEMETRY_SERIES_CAP=2000
# Let /api/probes/score export its results when a request asks (export_results).
#TELEMETRY_STATELESS_EXPORT_PERMITTED=false
# Which recorded origins become result log records.
#TELEMETRY_RESULT_LOG_ORIGINS=live,batch
#TELEMETRY_HEALTH_DEGRADED_WINDOW_S=60
#TELEMETRY_HEALTH_UNAVAILABLE_AFTER_S=300
# The one standard OpenTelemetry variable miLLM honours: true forces every signal off.
#OTEL_SDK_DISABLED=false

# ENH-008: how long an AI agent's request waits on the Approvals page (hours, at least 1) before it
# expires and can never run. Changeable while miLLM runs (Settings > Environment).
#APPROVAL_TTL_HOURS=24
