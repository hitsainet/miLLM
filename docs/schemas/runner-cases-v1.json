      "source": "def digit_sum(text, params):\n    table = set(params[\"sums\"])\n    n = 0\n    for token in text.split():\n        s = 0\n        for ch in token:\n            if \"0\" <= ch <= \"9\":\n                s += ord(ch) - 48\n        if s in table:\n            n += 1\n    return n\n"
    },
